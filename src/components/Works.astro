---
// Каталог работ на серых плашках с переключателем «Компьютер / Телефон».
// level: 1 на странице «Работы», 2 на главной.
import CaseCard from "./CaseCard.astro";
import { getCases } from "../scripts/cases";

interface Props {
  level?: 1 | 2;
}
const H = Astro.props.level === 1 ? "h1" : "h2";
const cases = await getCases();
---

<section class="works wrap" id="works" data-view="desktop" aria-labelledby="works-title">
  <div class="works__head">
    <H id="works-title" class="caps">Работы <span class="muted">({cases.length})</span></H>
    <div class="switch caps" role="group" aria-label="Какой экран показать">
      <button type="button" aria-pressed="true" data-view-btn="desktop">Компьютер</button>
      <button type="button" aria-pressed="false" data-view-btn="phone">Телефон</button>
    </div>
  </div>
  <ul class="works__grid">
    {cases.map((c, i) => <li><CaseCard entry={c} index={i} /></li>)}
  </ul>
</section>

<style>
  .works {
    padding-block: var(--s-16) var(--s-24);
    scroll-margin-top: var(--s-4);
  }
  .works__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }
  .works__head .caps:first-child {
    font-size: var(--fs-sm);
  }
  .works__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: var(--s-12) var(--s-6);
  }
  @media (min-width: 1700px) {
    .works__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  // Компьютер / Телефон: меняет скриншоты у всех работ
  const works = document.querySelector<HTMLElement>(".works");
  const btns = [...document.querySelectorAll<HTMLButtonElement>("[data-view-btn]")];
  btns.forEach((b) =>
    b.addEventListener("click", () => {
      if (!works) return;
      works.dataset.view = b.dataset.viewBtn;
      btns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    })
  );
</script>
