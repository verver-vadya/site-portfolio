---
import { href } from "../scripts/cases";
import { owner } from "../site";
const year = new Date().getFullYear();
const themes = [
  { value: "auto", label: "Как в системе" },
  { value: "light", label: "Светлая" },
  { value: "dark", label: "Тёмная" },
];
---

<footer class="footer wrap caps muted">
  <span>© verver, {year}</span>
  <span>{owner.fullName}, {owner.status}, ИНН {owner.inn}</span>
  <div class="theme" role="group" aria-label="Тема сайта" data-theme-switch>
    <span>Тема:</span>
    {
      themes.map((t) => (
        <button class="theme__btn" type="button" data-value={t.value} aria-pressed={t.value === "auto" ? "true" : "false"}>
          {t.label}
        </button>
      ))
    }
  </div>
  <a class="link" href={href("privacy/")}>Политика конфиденциальности</a>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    padding-block: var(--s-8) var(--s-6);
    border-top: 1px solid var(--c-line);
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  /* переключатель темы: просто слова, выбранное — основным цветом и подчёркнуто */
  .theme {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-3);
  }
  .theme__btn {
    min-height: 24px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: transparent;
    cursor: pointer;
    transition: color var(--d-fast) var(--ease-out), text-decoration-color var(--d-fast) var(--ease-out),
      opacity var(--d-fast) var(--ease-out);
  }
  @media (hover: hover) {
    .theme__btn:hover {
      color: var(--c-ink);
    }
  }
  .theme__btn:active {
    opacity: 0.6;
  }
  /* на телефоне пальцу нужна зона нажатия 44 px */
  @media (pointer: coarse), (max-width: 720px) {
    .theme__btn {
      min-height: 44px;
    }
  }
  .theme__btn[aria-pressed="true"] {
    color: var(--c-ink);
    text-decoration-color: currentColor;
    cursor: default;
  }
</style>

<script>
  // Тема: «Как в системе» убирает выбор, «Светлая» и «Тёмная» запоминаются в браузере
  const root = document.documentElement;
  const metas = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
  const color = { light: "#ffffff", dark: "#111111" } as const;

  function apply(value: string) {
    root.classList.add("is-theme-switching");
    if (value === "light" || value === "dark") {
      root.dataset.theme = value;
      metas.forEach((m) => (m.content = color[value]));
    } else {
      delete root.dataset.theme;
      metas.forEach((m) => (m.content = m.media.includes("dark") ? color.dark : color.light));
    }
    try {
      if (value === "auto") localStorage.removeItem("theme");
      else localStorage.setItem("theme", value);
    } catch {}
    mark(value);
    // переходы включаются обратно после того, как новые цвета отрисованы
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("is-theme-switching")));
  }

  function mark(value: string) {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-switch] button").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.value === value));
    });
  }

  mark(root.dataset.theme ?? "auto");
  document.querySelectorAll<HTMLElement>("[data-theme-switch]").forEach((group) => {
    group.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-value]");
      if (b) apply(b.dataset.value!);
    });
  });
</script>
