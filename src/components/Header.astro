---
import { href } from "../scripts/cases";
const home = href();
const path = Astro.url.pathname;
// у раздела и его вложенных страниц (работа внутри «Работ») пункт меню отмечен
const items = [
  { to: "works/", label: "Работы", also: "cases/" },
  { to: "prices/", label: "Цены" },
  { to: "about/", label: "Обо мне", cls: "nav__about" },
  { to: "contact/", label: "Связаться" },
].map((it) => {
  const here = path === href(it.to);
  const inside = here || path.startsWith(href(it.to)) || (it.also ? path.startsWith(href(it.also)) : false);
  return { ...it, here, inside };
});
---

<header class="header wrap">
  <a class="mark" href={home} aria-label="verver, на главную">verver</a>
  <nav aria-label="Разделы">
    <ul class="caps">
      {
        items.map((it) => (
          <li class={it.cls}>
            <a class:list={["link", { "is-here": it.inside }]} href={href(it.to)} aria-current={it.here ? "page" : undefined}>
              {it.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: var(--header-h);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mark);
    font-weight: 600;
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: opacity var(--d-fast) var(--ease-out);
  }
  .mark:active {
    opacity: 0.6;
  }
  ul {
    display: flex;
    gap: clamp(var(--s-4), 2.4vw, var(--s-8));
  }
  ul a {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    min-height: 44px;
    text-decoration-color: transparent;
  }
  /* текущий раздел подчёркнут постоянно */
  ul a.is-here {
    text-decoration-color: currentColor;
  }
  @media (max-width: 360px) {
    ul {
      gap: var(--s-4);
    }
    /* на узком телефоне четыре пункта не влезают: «Обо мне» есть в конце главной и других страниц */
    .nav__about {
      display: none;
    }
  }
</style>
