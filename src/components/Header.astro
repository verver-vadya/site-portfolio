---
import { href } from "../scripts/cases";
const home = href();
const path = Astro.url.pathname;
// у раздела и его вложенных страниц (работа внутри «Работ») пункт меню отмечен
const items = [
  { to: "works/", label: "Работы", also: "cases/" },
  { to: "prices/", label: "Цены" },
  { to: "about/", label: "Обо мне", cls: "nav__about" },
  { to: "contact/", label: "Связаться" },
].map((it) => {
  const here = path === href(it.to);
  const inside = here || path.startsWith(href(it.to)) || (it.also ? path.startsWith(href(it.also)) : false);
  return { ...it, here, inside };
});
---

<header class="header" data-header>
  <div class="header__in wrap">
  <a class="mark" href={home} aria-label="verver, на главную">{
    // буквы по отдельности: при приветствии знак собирается вразнобой
    "verver".split("").map((c, i) => <span style={`--d: ${[140, 0, 280, 70, 350, 210][i]}`}>{c}</span>)
  }</a>
  <nav aria-label="Разделы">
    <ul class="caps">
      {
        items.map((it) => (
          <li class={it.cls}>
            <a class:list={["link", { "is-here": it.inside }]} href={href(it.to)} aria-current={it.here ? "page" : undefined}>
              {it.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  </div>
</header>

<style>
  /* Шапка прилипает к верху: при прокрутке вниз уезжает, при прокрутке вверх возвращается */
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--c-paper);
    transition: transform 320ms var(--ease-soft), box-shadow var(--d-fast) var(--ease-out);
  }
  /* когда шапка вернулась посреди страницы, под ней тонкая линия */
  .header.is-floating {
    box-shadow: 0 1px 0 var(--c-line);
  }
  .header.is-hidden:not(:focus-within) {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    /* без движения шапка просто растворяется на месте */
    .header {
      transition: opacity 200ms var(--ease-out), visibility 200ms;
    }
    .header.is-hidden:not(:focus-within) {
      transform: none;
      opacity: 0;
      visibility: hidden;
    }
  }
  .header__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: var(--header-h);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mark);
    font-weight: 600;
    font-size: 1.625rem;
    line-height: 1;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: opacity var(--d-fast) var(--ease-out);
  }
  .mark:active {
    opacity: 0.6;
  }
  ul {
    display: flex;
    gap: clamp(var(--s-4), 2.4vw, var(--s-8));
  }
  ul a {
    display: inline-flex;
    white-space: nowrap;
    align-items: center;
    min-height: 44px;
    text-decoration-color: transparent;
  }
  /* текущий раздел подчёркнут постоянно */
  ul a.is-here {
    text-decoration-color: currentColor;
  }
  @media (max-width: 360px) {
    ul {
      gap: var(--s-4);
    }
    /* на узком телефоне четыре пункта не влезают: «Обо мне» есть в конце главной и других страниц */
    .nav__about {
      display: none;
    }
  }
</style>

<script>
  // Прячем шапку, только когда человек листает вниз ниже её высоты; лёгкая прокрутка вверх возвращает
  const header = document.querySelector<HTMLElement>("[data-header]");
  if (header) {
    let last = Math.max(0, scrollY);
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - innerHeight;
      const y = Math.min(Math.max(0, scrollY), max); // без отскока iOS у краёв
      const dy = y - last;
      const h = header.offsetHeight;
      if (y <= h) {
        header.classList.remove("is-hidden", "is-floating");
      } else if (dy > 6) {
        header.classList.add("is-hidden");
      } else if (dy < -6) {
        header.classList.remove("is-hidden");
        header.classList.add("is-floating");
      } else return; // мелкое дрожание пальца не считаем
      last = y;
    };
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
  }
</script>
