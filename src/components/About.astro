---
// «Обо мне»: кто делает сайты и что входит в работу. level: 1 на странице «Обо мне».
import { owner } from "../site";

interface Props {
  level?: 1 | 2;
}
const H = Astro.props.level === 1 ? "h1" : "h2";
---

<section class="about wrap" id="about" aria-labelledby="about-title">
  <H id="about-title" class="caps">Обо мне</H>
  <div class="about__body">
    <p class="about__lead">
      Меня зовут {owner.name}. Делаю сайты для небольших компаний и мастеров: от&nbsp;первого разговора
      до&nbsp;сайта, который работает на&nbsp;вашем хостинге и&nbsp;приводит заявки.
    </p>
    <dl class="about__list">
      <div><dt class="caps muted">Начало</dt><dd>Бриф, примеры, прототип главной за&nbsp;несколько дней</dd></div>
      <div><dt class="caps muted">Сайт</dt><dd>Дизайн под нишу, вёрстка для компьютера и&nbsp;телефона</dd></div>
      <div><dt class="caps muted">Заявки</dt><dd>Формы, онлайн-запись, оплата через ЮKassa</dd></div>
      <div><dt class="caps muted">Запуск</dt><dd>Хостинг и&nbsp;домен на&nbsp;ваше имя, Яндекс Метрика, 152-ФЗ</dd></div>
      <div><dt class="caps muted">После</dt><dd>Две недели бесплатных правок, потом поддержка по&nbsp;договорённости</dd></div>
    </dl>
    <p class="about__direct">
      <span class="caps muted">Напрямую</span>
      <a class="link" href={`https://t.me/${owner.telegram}`} target="_blank" rel="noopener">Telegram @{owner.telegram}</a>
      <a class="link" href={`mailto:${owner.email}`}>{owner.email}</a>
    </p>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--s-6) var(--s-12);
    padding-block: var(--s-16);
    border-top: 1px solid var(--c-line);
    scroll-margin-top: var(--s-4);
  }
  .about > .caps:first-child {
    font-size: var(--fs-sm);
  }
  .about__body {
    display: grid;
    gap: var(--s-12);
  }
  .about__lead {
    max-width: 30ch;
    font-size: var(--fs-xl);
    font-weight: 600;
    line-height: 1.1;
    text-wrap: pretty;
  }
  .about__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
    gap: var(--s-6);
  }
  .about__list div {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-top: var(--s-3);
    border-top: 1.5px solid var(--c-ink);
  }
  .about__list dd {
    max-width: 30ch;
  }
  .about__direct {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-6);
  }
  .about__direct a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-md);
    overflow-wrap: anywhere;
  }
  @media (max-width: 720px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
