---
// Призыв в конце страницы: оставить заявку, рядом ссылки на соседние разделы.
import { href } from "../scripts/cases";

interface Props {
  links?: { label: string; to: string }[];
}
const { links = [] } = Astro.props;
---

<section class="cta wrap" aria-labelledby="cta-title">
  <p class="caps muted">Дальше</p>
  <div class="cta__body">
    <h2 id="cta-title" class="cta__title">Расскажите о&nbsp;задаче, отвечу в&nbsp;течение дня</h2>
    <div class="cta__row">
      <a class="btn" href={href("contact/")}>Оставить заявку</a>
      {links.map((l) => <a class="link caps cta__link" href={href(l.to)}>{l.label}</a>)}
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--s-6) var(--s-12);
    padding-block: var(--s-16) var(--s-24);
    border-top: 1px solid var(--c-line);
  }
  .cta > .caps {
    font-size: var(--fs-sm);
  }
  .cta__body {
    display: grid;
    gap: var(--s-8);
  }
  .cta__title {
    max-width: 22ch;
    font-size: var(--fs-xl);
    font-weight: 760;
    line-height: var(--lh-head);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .cta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-8);
  }
  .cta__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (max-width: 720px) {
    .cta {
      grid-template-columns: 1fr;
    }
    .cta .btn {
      flex: 1 0 100%;
      justify-content: center;
    }
  }
</style>
