---
// Заявка: четыре вопроса брифа, согласие по 152-ФЗ и запасной путь — Telegram и почта.
// Заявки уходят в Formspree: номер формы задаётся в src/site.ts (см. README).
import { href } from "../scripts/cases";
import { owner } from "../site";
import Me from "./Me.astro";

const types = ["Лендинг", "Визитка или портфолио", "Сайт с записью или каталогом", "Пока не знаю"];
const terms = ["Нужно за 2–3 недели", "В течение месяца-двух", "Не горит", "Пока не знаю"];
interface Props {
  level?: 1 | 2; // 1 на странице «Связаться»
}
const H = Astro.props.level === 1 ? "h1" : "h2";
const budgets = ["До 20 000 ₽", "20–40 тысяч ₽", "40–70 тысяч ₽", "Больше 70 тысяч ₽", "Пока не знаю"];
---

<section class="contact wrap" id="contact" aria-labelledby="contact-title">
  <H id="contact-title" class="caps">Заявка</H>
  <div class="contact__body">
    <div class="contact__intro">
      <p class="contact__lead">Расскажите о&nbsp;задаче</p>
      <div class="contact__who">
        <Me size={64} />
        <p><b>Отвечу я, {owner.name}.</b> <span class="muted">Четыре вопроса, пара минут, ни&nbsp;к&nbsp;чему не&nbsp;обязывает.</span></p>
      </div>
    </div>

    <form class="form" action={`https://formspree.io/f/${owner.formspree}`} method="post" data-form>
      <input type="hidden" name="_subject" value="Заявка с сайта-портфолио" />

      <div class="field">
        <label class="caps" for="f-name">Как к вам обращаться</label>
        <input id="f-name" name="Имя" type="text" autocomplete="name" required minlength="2"
          data-error-required="Напишите, как к вам обращаться" />
      </div>
      <div class="field">
        <label class="caps" for="f-contact">Куда ответить</label>
        <input id="f-contact" name="Контакт" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" required
          data-validate="contact" aria-describedby="f-contact-hint"
          data-error-required="Напишите ник в Telegram, телефон или почту" />
        <p class="field__hint muted" id="f-contact-hint">Ник в Telegram, телефон или почта</p>
      </div>

      <div class="field field--wide">
        <label class="caps" for="f-business">Чем занимается бизнес</label>
        <input id="f-business" name="Бизнес" type="text" required minlength="3" aria-describedby="f-business-hint"
          data-error-required="Пара слов о том, чем вы занимаетесь" />
        <p class="field__hint muted" id="f-business-hint">Например: салон стрижки в&nbsp;Казани, ремонт квартир</p>
      </div>

      <fieldset class="field field--wide" data-name="f-type">
        <legend class="caps">Какой сайт нужен</legend>
        <div class="choice">
          {
            types.map((t, i) => (
              <label class="choice__item">
                <input id={i === 0 ? "f-type" : undefined} type="radio" name="Какой сайт" value={t} required
                  data-error-required="Выберите, какой сайт нужен, или «Пока не знаю»" />
                <span>{t}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="field field--wide" data-name="f-when">
        <legend class="caps">Сроки</legend>
        <div class="choice">
          {
            terms.map((t, i) => (
              <label class="choice__item">
                <input id={i === 0 ? "f-when" : undefined} type="radio" name="Сроки" value={t} />
                <span>{t}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="field field--wide" data-name="f-budget">
        <legend class="caps">Бюджет</legend>
        <div class="choice">
          {
            budgets.map((t, i) => (
              <label class="choice__item">
                <input id={i === 0 ? "f-budget" : undefined} type="radio" name="Бюджет" value={t} />
                <span>{t}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="field field--wide">
        <label class="caps" for="f-message">Что ещё важно <span class="muted">(необязательно)</span></label>
        <textarea id="f-message" name="Комментарий" rows="4" maxlength="2000" aria-describedby="f-message-hint"></textarea>
        <p class="field__hint muted" id="f-message-hint">Ссылка на сайт сейчас, примеры, которые нравятся, дата запуска</p>
      </div>

      <div class="field field--wide field--check">
        <input id="f-consent" name="Согласие" type="checkbox" value="да" required
          data-error-required="Без согласия на обработку данных я не могу принять заявку" />
        <label for="f-consent">
          Даю согласие на&nbsp;обработку персональных данных по&nbsp;<a class="link link--line" href={href("privacy/")}>политике конфиденциальности</a>
        </label>
      </div>

      <!-- Ловушка для спам-ботов: человек это поле не видит -->
      <input class="form__trap" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="form__send field--wide">
        <button class="btn" type="submit">Отправить заявку</button>
        <p class="form__status" role="status" aria-live="polite" hidden></p>
        <ol class="next">
          <li><span class="caps muted">01</span>Отвечу в&nbsp;течение дня туда, куда вы указали</li>
          <li><span class="caps muted">02</span>Если нужно, созвонимся на&nbsp;15&nbsp;минут</li>
          <li><span class="caps muted">03</span>Пришлю цену, сроки и&nbsp;что войдёт в&nbsp;работу</li>
        </ol>
      </div>
    </form>

    <p class="contact__direct">
      <span class="caps muted">Или напрямую</span>
      <a class="link link--line" href={`https://t.me/${owner.telegram}`}>Telegram @{owner.telegram}</a>
      <a class="link link--line" href={`mailto:${owner.email}`}>{owner.email}</a>
    </p>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--s-6) var(--s-12);
    padding-block: var(--s-16) var(--s-24);
    border-top: 1px solid var(--c-line);
    scroll-margin-top: var(--s-4);
  }
  .contact > .caps:first-child {
    font-size: var(--fs-sm);
  }
  .contact__body {
    display: grid;
    gap: var(--s-12);
    max-width: 960px;
  }
  .contact__intro {
    display: grid;
    gap: var(--s-3);
  }
  .contact__who {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    max-width: 52ch;
  }
  .contact__lead {
    font-size: var(--fs-xl);
    font-weight: 760;
    line-height: var(--lh-head);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8) var(--s-6);
  }
  .field {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .field--wide {
    grid-column: 1 / -1;
  }
  .field legend {
    float: left; /* чтобы legend встал в сетку, как label */
    width: 100%;
    margin-bottom: var(--s-2);
    padding: 0;
  }
  .field__hint {
    font-size: var(--fs-xs);
  }

  .field input:not([type="checkbox"], [type="radio"]),
  .field textarea {
    width: 100%;
    min-height: 52px;
    padding: var(--s-3) var(--s-4);
    border: 1.5px solid var(--c-field);
    border-radius: var(--radius-plate);
    background: var(--c-paper);
    color: var(--c-ink);
    font: inherit;
    transition: border-color var(--d-fast) var(--ease-out);
  }
  .field textarea {
    min-height: 120px;
    resize: vertical;
  }
  @media (hover: hover) {
    .field input:not([type="checkbox"], [type="radio"]):hover,
    .field textarea:hover {
      border-color: var(--c-ink);
    }
  }
  .field input:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--c-ink);
    outline-offset: 2px;
  }
  .field [aria-invalid="true"]:not([type="radio"]) {
    border-color: var(--c-danger) !important;
    box-shadow: inset 0 0 0 1px var(--c-danger);
  }
  .field :global(.field__error) {
    color: var(--c-danger);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  /* тип сайта: кнопки-бирки */
  .choice {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .choice__item {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-4);
    border: 1.5px solid var(--c-field);
    border-radius: var(--radius-pill);
    background: var(--c-paper);
    cursor: pointer;
    user-select: none;
    transition: background-color var(--d-fast) var(--ease-out), color var(--d-fast) var(--ease-out),
      border-color var(--d-fast) var(--ease-out), transform var(--d-fast) var(--ease-out);
  }
  .choice__item input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  @media (hover: hover) {
    .choice__item:hover {
      border-color: var(--c-ink);
    }
    .choice__item:has(input:checked):hover {
      background: #333;
    }
  }
  .choice__item:active {
    transform: scale(0.97);
  }
  .choice__item:has(input:checked) {
    border-color: var(--c-ink);
    background: var(--c-ink);
    color: var(--c-paper);
  }
  .choice__item:has(input:focus-visible) {
    outline: 2px solid var(--c-focus);
    outline-offset: 3px;
  }
  .choice__item:has(input[aria-invalid="true"]) {
    border-color: var(--c-danger);
  }

  .field--check {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: var(--s-3);
  }
  .field--check input {
    width: 22px;
    height: 22px;
    margin: 1px 0 0;
    accent-color: var(--c-ink);
    cursor: pointer;
  }
  .field--check label {
    font-size: var(--fs-sm);
    cursor: pointer;
  }
  .field--check :global(.field__error) {
    grid-column: 1 / -1;
  }
  .link--line {
    text-decoration-color: currentColor;
  }

  .form__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .form__send {
    display: grid;
    justify-items: start;
    gap: var(--s-4);
  }
  .form__send .btn {
    font: inherit;
    font-weight: 600;
  }
  .form__send .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  /* что будет после заявки */
  .next {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    width: 100%;
    margin: var(--s-2) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
  }
  .next li {
    display: grid;
    gap: var(--s-1);
    align-content: start;
    padding-top: var(--s-3);
    border-top: 1px solid var(--c-line);
  }
  .form__status {
    max-width: 62ch;
    padding: var(--s-3) var(--s-4);
    border-left: 3px solid;
    border-radius: 0 var(--radius-plate) var(--radius-plate) 0;
    background: var(--c-plate);
    font-size: var(--fs-sm);
  }
  .form__status[data-state="success"] {
    color: var(--c-success);
  }
  .form__status[data-state="error"] {
    color: var(--c-danger);
  }

  .contact__direct {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-6);
    padding-top: var(--s-6);
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-lg);
    font-weight: 600;
  }
  .contact__direct a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 720px) {
    .contact {
      grid-template-columns: 1fr;
    }
    .form {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-6);
    }
    .form__send .btn {
      justify-self: stretch;
      justify-content: center;
    }
    .next {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-3);
    }
    .contact__direct {
      font-size: var(--fs-md);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .choice__item {
      transition-property: background-color, color, border-color;
    }
  }
</style>

<script>
  import "../scripts/form";
</script>
