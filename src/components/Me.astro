---
// Фото владельца в круге. Берёт src/assets/me.jpg (или .png/.webp), пока файла нет — серый круг со знаком v.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { owner } from "../site";

interface Props {
  size?: number;
}
const { size = 72 } = Astro.props;
const found = import.meta.glob<{ default: ImageMetadata }>("../assets/me.{jpg,jpeg,png,webp}", { eager: true });
const photo = Object.values(found)[0]?.default;
---

{
  photo ? (
    <Image class="me" src={photo} alt={`Фото: ${owner.name}`} width={size * 2} height={size * 2} style={`--size: ${size}px`} />
  ) : (
    <span class="me me--empty" style={`--size: ${size}px`} aria-hidden="true">v</span>
  )
}

<style>
  .me {
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    object-fit: cover;
    background: var(--c-plate);
  }
  .me--empty {
    display: inline-grid;
    place-items: center;
    font-family: var(--font-mark);
    font-weight: 600;
    font-size: calc(var(--size) * 0.45);
    line-height: 1;
    color: var(--c-muted);
  }
</style>
