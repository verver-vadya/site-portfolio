---
// Карточка работы: скриншот на серой плашке, как вещь в каталоге.
// Показывает экран компьютера или телефона, переключает .works[data-view].
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { href, statusLabel } from "../scripts/cases";

interface Props {
  entry: CollectionEntry<"cases">;
  index: number;
}
const { entry, index } = Astro.props;
const d = entry.data;
---

<a class="card" href={href(`cases/${entry.id}/`)}>
  <div class="card__plate">
    <Image
      class="card__shot card__shot--desktop"
      src={d.desktop[0]}
      alt={`«${d.title}» на компьютере`}
      widths={[640, 1080, 1600]}
      sizes="(max-width: 720px) 92vw, 46vw"
      quality={80}
      loading={index < 2 ? "eager" : "lazy"}
    />
    <Image
      class="card__shot card__shot--phone"
      src={d.phone[0]}
      alt={`«${d.title}» на телефоне`}
      widths={[260, 520]}
      sizes="(max-width: 720px) 42vw, 18vw"
      quality={80}
      loading="lazy"
    />
  </div>
  <div class="card__text">
    <span class="card__title">{d.title}</span>
    <span class="card__meta muted">{d.niche}, {d.city}, {d.year}</span>
    <span class="card__tag caps tag">{statusLabel[d.status]}</span>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-3);
    text-decoration: none;
  }
  .card__plate {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: clip;
    border-radius: var(--radius-plate);
    background: var(--c-plate);
  }
  .card__shot {
    grid-area: 1 / 1;
    box-shadow: var(--shadow-shot);
    transition: opacity 320ms var(--ease-soft), transform var(--d-soft) var(--ease-soft);
  }
  .card__shot--desktop {
    width: 84%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: 3px;
  }
  .card__shot--phone {
    /* вне потока, чтобы ширина картинки не распирала карточку */
    position: absolute;
    top: 7%;
    left: 0;
    right: 0;
    margin-inline: auto;
    height: 86%;
    width: auto;
    aspect-ratio: 390 / 844;
    object-fit: cover;
    object-position: top;
    border-radius: 14px;
  }
  /* какой экран виден */
  :global(.works[data-view="desktop"]) .card__shot--phone,
  :global(.works[data-view="phone"]) .card__shot--desktop {
    opacity: 0;
    transform: scale(0.98);
  }
  @media (hover: hover) {
    .card:hover .card__shot {
      transform: translateY(-6px) scale(1.015);
    }
    :global(.works[data-view="desktop"]) .card:hover .card__shot--phone,
    :global(.works[data-view="phone"]) .card:hover .card__shot--desktop {
      transform: scale(0.98);
    }
  }
  .card:active .card__plate {
    opacity: 0.85;
  }
  .card__plate {
    transition: opacity var(--d-fast) var(--ease-out);
  }

  .card__text {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    column-gap: var(--s-4);
  }
  .card__title {
    font-size: var(--fs-md);
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .card__meta {
    grid-column: 1;
    font-size: var(--fs-sm);
  }
  .card__tag {
    grid-column: 2;
    grid-row: 1 / 3;
  }
  @media (prefers-reduced-motion: reduce) {
    .card__shot {
      transition: opacity 200ms ease-out;
      transform: none !important;
    }
  }
</style>
