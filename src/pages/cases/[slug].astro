---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getCases, href, statusLabel } from "../../scripts/cases";

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const host = new URL(d.url).host + new URL(d.url).pathname.replace(/\/$/, "");
---

<Base title={`${d.title} — ${d.niche.toLowerCase()} · verver`} description={d.summary}>
  <article class="case wrap">
    <a class="case__back caps link" href={href("works/")}>← Все работы</a>

    <header class="case__head">
      <h1 class="case__title">{d.title}</h1>
      <p class="case__summary">{d.summary}</p>
      <dl class="case__facts">
        <div><dt class="caps muted">Ниша</dt><dd>{d.niche}</dd></div>
        <div><dt class="caps muted">Город</dt><dd>{d.city}</dd></div>
        <div><dt class="caps muted">Год</dt><dd>{d.year}</dd></div>
        {d.term && <div><dt class="caps muted">Срок</dt><dd>{d.term}</dd></div>}
        <div>
          <dt class="caps muted">Формат</dt>
          <dd>{d.status === "concept" ? "Концепт: учебная работа без заказчика" : statusLabel[d.status]}</dd>
        </div>
        <div>
          <dt class="caps muted">Сайт</dt>
          <dd>
            {d.live ? (
              <a class="link case__url" href={d.url} target="_blank" rel="noopener">{host} ↗</a>
            ) : (
              <span class="muted">превью появится после запуска</span>
            )}
          </dd>
        </div>
      </dl>
    </header>

    <figure class="case__shot case__shot--wide">
      <Image src={d.desktop[0]} alt={`«${d.title}»: первый экран на компьютере`} widths={[800, 1440, 2160]} sizes="(max-width: 1760px) 96vw, 1680px" quality={82} loading="eager" fetchpriority="high" />
    </figure>

    <div class="case__text">
      <Content />
    </div>

    <ul class="case__phones">
      {
        d.phone.map((img, i) => (
          <li class="case__phone">
            <Image src={img} alt={`«${d.title}» на телефоне, экран ${i + 1}`} widths={[300, 600]} sizes="(max-width: 720px) 60vw, 22vw" quality={82} />
          </li>
        ))
      }
    </ul>

    {
      d.desktop.slice(1).map((img, i) => (
        <figure class="case__shot">
          <Image src={img} alt={`«${d.title}» на компьютере, экран ${i + 2}`} widths={[800, 1440, 2160]} sizes="(max-width: 1760px) 96vw, 1680px" quality={82} />
        </figure>
      ))
    }

    {
      next.id !== entry.id && (
        <a class="case__next" href={href(`cases/${next.id}/`)}>
          <span class="caps muted">Следующая работа</span>
          <span class="case__next-title">{next.data.title} →</span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .case {
    display: grid;
    gap: var(--s-12);
    padding-block: var(--s-4) var(--s-24);
  }
  .case__back {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .case__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-8) var(--s-12);
    align-items: end;
  }
  .case__title {
    grid-column: 1 / -1;
    font-size: var(--fs-2xl);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .case__summary {
    max-width: 34ch;
    font-size: var(--fs-lg);
    line-height: 1.3;
  }
  .case__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--s-4) var(--s-6);
  }
  .case__facts div {
    display: grid;
    gap: var(--s-1);
    padding-top: var(--s-2);
    border-top: 1.5px solid var(--c-ink);
  }
  .case__url {
    overflow-wrap: anywhere;
  }

  .case__shot {
    margin: 0;
    padding: clamp(var(--s-4), 4vw, var(--s-16));
    border-radius: var(--radius-plate);
    background: var(--c-plate);
  }
  .case__shot :global(img) {
    width: 100%;
    border-radius: 3px;
    box-shadow: var(--shadow-shot);
  }

  .case__text {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--s-4) var(--s-12);
    max-width: 1280px;
  }
  .case__text :global(h2) {
    grid-column: 1;
    font-size: var(--fs-sm);
    font-weight: 560;
    letter-spacing: var(--caps-spacing);
    text-transform: uppercase;
    padding-top: 0.35em;
  }
  .case__text :global(p) {
    grid-column: 2;
    max-width: 62ch;
    font-size: var(--fs-md);
    margin-bottom: var(--s-6);
  }

  .case__phones {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
    padding: clamp(var(--s-4), 4vw, var(--s-16));
    border-radius: var(--radius-plate);
    background: var(--c-plate);
  }
  .case__phone :global(img) {
    width: 100%;
    max-width: 360px;
    margin-inline: auto;
    border-radius: 18px;
    box-shadow: var(--shadow-shot);
  }

  .case__next {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-8);
    border-top: 1px solid var(--c-line);
    text-decoration: none;
  }
  .case__next-title {
    font-size: var(--fs-xl);
    font-weight: 760;
    line-height: 1;
    text-transform: uppercase;
    transition: transform var(--d-soft) var(--ease-soft), opacity var(--d-fast) var(--ease-out);
  }
  @media (hover: hover) {
    .case__next:hover .case__next-title {
      transform: translateX(12px);
    }
  }
  .case__next:active .case__next-title {
    opacity: 0.6;
  }

  @media (max-width: 720px) {
    .case__head,
    .case__text {
      grid-template-columns: 1fr;
    }
    .case__text :global(h2),
    .case__text :global(p) {
      grid-column: 1;
    }
    .case__phones {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 64%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
    }
    .case__phone {
      scroll-snap-align: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .case__next-title {
      transition: opacity var(--d-fast) ease-out;
    }
    .case__next:hover .case__next-title {
      transform: none;
    }
  }
</style>
