---
import Base from "../layouts/Base.astro";
import Ring from "../components/Ring.astro";
import Works from "../components/Works.astro";
import Cta from "../components/Cta.astro";
import { getCases } from "../scripts/cases";

const cases = await getCases();
---

<Base
  intro
  title="verver — сайты под задачу бизнеса"
  description="Делаю сайты под ключ: бриф, дизайн, вёрстка, формы и запись, запуск. Работы и контакты."
>
  <section class="hero" data-ring-scope aria-labelledby="hero-title">
    <div class="wrap hero__intro">
      <h1 id="hero-title" class="hero__title">Сайты под задачу бизнеса: от&nbsp;брифа до&nbsp;запуска</h1>
      <p class="hero__lede muted">
        Дизайн, вёрстка, формы и&nbsp;онлайн-запись. Сайт, хостинг и&nbsp;домен оформляются на&nbsp;владельца.
      </p>
    </div>
    <Ring cases={cases} />
  </section>

  <Works />
  <Cta links={[{ label: "Цены и сроки", to: "prices/" }, { label: "Обо мне", to: "about/" }]} />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100svh - var(--header-h));
    overflow-x: clip;
  }
  .hero__intro {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--s-4) var(--s-12);
    padding-block: var(--s-4) var(--s-6);
  }
  .hero__title {
    max-width: 22ch;
    /* на низких экранах заголовок меньше, чтобы кольцо помещалось */
    font-size: clamp(2rem, min(1.4rem + 2.6vw, 7svh), 3.5rem);
    font-weight: 760;
    line-height: var(--lh-head);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .hero__lede {
    max-width: 38ch;
    justify-self: end;
    font-size: var(--fs-md);
  }

  @media (max-width: 720px) {
    .hero {
      min-height: calc(100svh - var(--header-h));
    }
    .hero__intro {
      grid-template-columns: 1fr;
      padding-bottom: var(--s-2);
    }
    .hero__lede {
      justify-self: start;
      font-size: var(--fs-sm);
    }
  }
</style>
